@article{berg2022modelfreereadouterrormitigation,
  title = {Model-Free Readout-Error Mitigation for Quantum Expectation Values},
  author = {family=Berg, given=Ewout, prefix=van den, useprefix=false and Minev, Zlatko K. and Temme, Kristan},
  date = {2022-03-30},
  journaltitle = {Physical Review A},
  shortjournal = {Phys. Rev. A},
  volume = {105},
  number = {3},
  eprint = {2012.09738},
  eprinttype = {arXiv},
  eprintclass = {quant-ph},
  pages = {032620},
  issn = {2469-9926, 2469-9934},
  doi = {10.1103/PhysRevA.105.032620},
  url = {http://arxiv.org/abs/2012.09738},
  urldate = {2026-07-15},
  abstract = {Measurements on current quantum processors are subject to hardware imperfections that lead to readout errors. These errors manifest themselves as a bias in quantum expectation values. Here, we propose a very simple method that forces the bias in the expectation value to appear as a multiplicative factor that can be measured directly and removed at the cost of an increase in the sampling complexity for the observable. The method assumes no specific form of the noise, but only requires that the noise is `weak' to avoid excessive sampling overhead. We provide bounds relating the error in the expectation value to the sample complexity.},
  langid = {english},
  keywords = {Quantum Physics},
}

